# --- Robinhood Chain mainnet (defaults) ---
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER=https://robinhoodchain.blockscout.com
NEXT_PUBLIC_WIF=0x5173b8eA6923c2d40267890D45C46a3480954773

# --- set these after deploying FlatBallot ---
NEXT_PUBLIC_BALLOT=
# block FlatBallot was deployed in (event scans start here)
NEXT_PUBLIC_DEPLOY_BLOCK=0
# block $WIF was deployed in (funder lookups start here; recorded in the rules hash)
NEXT_PUBLIC_WIF_DEPLOY_BLOCK=0
# eth_getLogs block span per request; lower it if your RPC rejects large ranges
NEXT_PUBLIC_LOG_CHUNK=50000

# --- wallet connections (Reown AppKit / WalletConnect) ---
# Free project ID from https://cloud.reown.com ; add your site domain to the project's allowed domains.
NEXT_PUBLIC_REOWN_PROJECT_ID=
